root = true

[*.cs]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = crlf
insert_final_newline = true

dotnet_naming_rule.types_and_members.symbols = types_and_members
dotnet_naming_rule.types_and_members.style = pascal_case
dotnet_naming_rule.types_and_members.severity = suggestion
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, property, method
dotnet_naming_style.pascal_case.capitalization = pascal_case
